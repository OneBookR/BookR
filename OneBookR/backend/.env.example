# ===== ENVIRONMENT CONFIGURATION =====
NODE_ENV=development

# ===== OAUTH CREDENTIALS =====
# Google OAuth (required)
CLIENT_ID=your_google_client_id_here
CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Microsoft OAuth (required)
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback

# ===== APPLICATION URLS =====
# Frontend URL (Vite dev server)
FRONTEND_URL=http://localhost:5173

# Backend URL (Express server)
BACKEND_URL=http://localhost:3000

# ===== EMAIL SERVICE =====
# Resend API for sending invitations
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=BookR <noreply@onebookr.se>

# ===== SESSION SECURITY =====
SESSION_SECRET=your_secure_session_secret_here

# ===== TOKEN ENCRYPTION =====
# 64-char hex string (32 bytes) used to encrypt OAuth tokens in the session
# and BookRs egen admin-kalender-token. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# ===== ADMIN: BOKA-DEMO KALENDERKOPPLING =====
# Delad hemlighet som skyddar /admin/connect-calendar — engångssteg för
# att koppla BookRs egen kalender till "boka demo"-flödet. Välj ett långt,
# slumpmässigt värde. Besök https://www.onebookr.se/admin/connect-calendar?secret=<detta värde>
ADMIN_SETUP_SECRET=your_long_random_admin_secret_here

# ===== FIREBASE (OPTIONAL) =====
# Firebase configuration for logging and analytics
# Use either FIREBASE_SERVICE_ACCOUNT as a full JSON string,
# or provide the individual fields below.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id"}
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_CLIENT_ID=your_firebase_client_id

# ===== HUBSPOT (OPTIONAL) =====
# Private App access token från HubSpot (scope: crm.objects.contacts.write).
# Skapa under HubSpot → Settings → Integrations → Private Apps. Utan denna
# variabel är integrationen helt avstängd (no-op, loggar bara en varning) —
# resten av appen fungerar precis som vanligt.
# Kräver även att egna kontakt-properties skapas manuellt i HubSpot
# (Settings → Properties → Contact properties) med interna namn:
# bookr_lead_id, bookr_login_provider, bookr_lead_source
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# ===== STRIPE (BILLING) =====
# Utan STRIPE_SECRET_KEY är hela billing-modulen avstängd (routes svarar 503),
# resten av appen fungerar som vanligt.
# 1. STRIPE_SECRET_KEY: sk_test_... (test) eller sk_live_... (prod)
# 2. Kör:  STRIPE_SECRET_KEY=sk_test_xxx node OneBookR/backend/scripts/stripe-setup.mjs
#    → skapar produkter/priser och skriver ut PRICE-ID:na nedan
# 3. STRIPE_WEBHOOK_SECRET:
#    lokalt:  stripe listen --forward-to localhost:3000/api/webhooks/stripe  (ger whsec_...)
#    prod:    Dashboard → Developers → Webhooks → endpoint https://www.onebookr.se/api/webhooks/stripe
#             events: checkout.session.completed, customer.subscription.updated,
#                     customer.subscription.deleted, invoice.payment_failed
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx
STRIPE_PRICE_BUSINESS_YEARLY=price_xxx

# ===== ACCESS / SIGNUP =====
# Privat beta: kommaseparerad lista på tillåtna inloggnings-mejl.
# Öppna signup för alla: sätt värdet till *  (eller lämna helt tomt).
# Osatt = nuvarande whitelist (privat beta).
ALLOWED_LOGIN_EMAILS=info@onebookr.se,gustav@onebookr.se,av.goransson@gmail.com

# ===== LOCALHOST DEVELOPMENT NOTES =====
# 1. Copy this file to .env and fill in your actual values
# 2. Make sure frontend runs on port 5173 (npm run dev)
# 3. Make sure backend runs on port 3000 (npm start)
# 4. OAuth callbacks must match the URLs above in your OAuth app settings