# ===== ENVIRONMENT CONFIGURATION =====
NODE_ENV=development

# ===== OAUTH CREDENTIALS =====
# Google OAuth (required)
CLIENT_ID=your_google_client_id_here
CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Microsoft OAuth (required)
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_CALLBACK_URL=http://localhost:3000/auth/microsoft/callback

# ===== APPLICATION URLS =====
# Frontend URL (Vite dev server)
FRONTEND_URL=http://localhost:5173

# Backend URL (Express server)
BACKEND_URL=http://localhost:3000

# ===== EMAIL SERVICE =====
# Resend API for sending invitations
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=BookR <noreply@onebookr.se>

# ===== SESSION SECURITY =====
SESSION_SECRET=your_secure_session_secret_here

# ===== FIREBASE (OPTIONAL) =====
# Firebase configuration for logging and analytics
# Use either FIREBASE_SERVICE_ACCOUNT as a full JSON string,
# or provide the individual fields below.
# Firebase Admin SDK (required for backend Firestore)
# Option 1 (recommended for local dev): place a service account file at backend/firebase-key.json
# or point to another file:
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-key.json

# Option 2 (recommended for Railway/CI): one-line JSON string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Option 3: split fields (if you cannot use JSON/file)
# FIREBASE_PROJECT_ID=your_firebase_project_id
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com

# ===== LOCALHOST DEVELOPMENT NOTES =====
# 1. Copy this file to .env and fill in your actual values
# 2. Make sure frontend runs on port 5173 (npm run dev)
# 3. Make sure backend runs on port 3000 (npm start)
# 4. OAuth callbacks must match the URLs above in your OAuth app settings